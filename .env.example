# Public site URL used for canonical links, Open Graph tags, sitemap.xml and structured data.
# Change this when the site moves to a custom domain, then rebuild.
VITE_SITE_URL=https://pymlabs.unaux.com

# Optional: a form endpoint that accepts POST requests (for example a Formspree/Getform/Web3Forms URL,
# or your own PHP script). Leave empty to use the email-app (mailto) enquiry flow.
VITE_FORM_ENDPOINT=

# EmailJS contact form (public IDs from dashboard.emailjs.com). The form uses EmailJS when all three are set.
VITE_EMAILJS_SERVICE_ID=service_7txywke
VITE_EMAILJS_TEMPLATE_ID=template_go4o4a4
VITE_EMAILJS_PUBLIC_KEY=qhBCc-L3zbntEpAwm
